# Copy to .env locally. Never commit real credentials.
POLZA_API_KEY=
# Required: use the exact model ID from your Polza account; no automatic model selection.
POLZA_MODEL=
MAX_OUTPUT_TOKENS=1800
MAX_MODEL_CALLS_PER_HOUR=30
MAX_MODEL_CALLS_TOTAL=300
RECENT_CONTEXT_MESSAGES=24
SUMMARY_TRIGGER_MESSAGES=12
