# Telegram (my.telegram.org → API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Кому отвечает бот: список ников/ID или все личные чаты (для защиты и тестов)
TARGET_USERNAMES=
TARGET_USER_IDS=
ALLOW_ALL_PRIVATE_CHATS=false
# Чат менеджера, куда приходят карточки лидов (ID пользователя или группы)
ADMIN_CHAT_ID=

# AWS Bedrock: либо пара IAM-ключей, либо bearer-токен
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=eu-north-1
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-6

# Лимиты и поведение (значения по умолчанию)
MAX_OUTPUT_TOKENS=1500
MAX_MODEL_CALLS_PER_HOUR=120
MAX_MODEL_CALLS_TOTAL=5000
RECENT_CONTEXT_MESSAGES=30
SUMMARY_TRIGGER_MESSAGES=16
MAX_REPLY_BUBBLES=3
FOLLOWUP_TIMEOUT_SECONDS=900
LOG_LEVEL=INFO
